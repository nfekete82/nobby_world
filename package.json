{
  "name": "nobby-world",
  "version": "0.2.0-dev.0",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:production": "node --test test/production-preview.test.mjs",
    "start": "vite --host 127.0.0.1 --port 8088",
    "preview": "vite preview --host 127.0.0.1 --port 8088",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/browser-review.cjs",
    "worlds:check": "node scripts/world-data.mjs",
    "world:new": "node scripts/new-world.mjs",
    "editor:setup": "sh scripts/setup-editor.sh",
    "editor": "npm run editor:setup && open -a \"$PWD/.tools/Tiled.app\" \"$PWD/nobby-world.tiled-project\" \"$PWD/src/tiled/simplemap.tmx\"",
    "prebuild": "node scripts/world-data.mjs",
    "predev": "node scripts/world-data.mjs",
    "prestart": "node scripts/world-data.mjs",
    "test:editor": "node scripts/editor-review.cjs",
    "art:prepare": "node scripts/compile-art.mjs",
    "test:art": "node scripts/art-review.cjs",
    "art:check": "node scripts/preflight-art.mjs",
    "test:click": "node scripts/click-move-review.cjs",
    "test:spell": "node scripts/spell-review.cjs",
    "pretest": "node scripts/world-data.mjs",
    "preart:check": "node scripts/world-data.mjs",
    "test:web-editor": "node scripts/web-editor-review.cjs",
    "test:sheep": "node scripts/sheep-review.cjs",
    "test:expansion": "node scripts/expansion-review.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "Nobby World — local Tiny Swords pixel-art RPG and map workshop",
  "devDependencies": {
    "@canvasengine/compiler": "2.4.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "path-browserify": "^1.0.1",
    "playwright": "1.64.0",
    "pngjs": "7.0.0",
    "vite": "^8.3.4",
    "xml-js": "^1.6.11"
  },
  "private": true,
  "dependencies": {
    "@canvasengine/presets": "2.4.0",
    "@rpgjs/action-battle": "5.0.0",
    "@rpgjs/client": "5.0.0",
    "@rpgjs/common": "5.0.0",
    "@rpgjs/server": "5.0.0",
    "@rpgjs/tiledmap": "5.0.0",
    "@rpgjs/ui-css": "5.0.0",
    "@rpgjs/vite": "5.0.0",
    "@signe/di": "^3.1.1",
    "canvasengine": "2.4.0",
    "pixi.js": "^8.22.0"
  },
  "type": "module"
}
